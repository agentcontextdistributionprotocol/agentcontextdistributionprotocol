    {
      "name": "D — unknown record-digest version",
      "input": {
        "record": "scenario A's inputs with schema_version = 3",
        "anchor": {
          "scheme": "seam.decision",
          "content_hash": "sha256:7f230b80d79b8af05be44507c7356032b4e93d32818dbf97ef530786bc4e6004"
