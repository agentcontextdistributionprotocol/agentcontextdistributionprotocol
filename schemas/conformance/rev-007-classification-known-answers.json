      "input": {
        "context": {
          "agent_id": "did:web:agents.example.com:producer-a",
          "key_fingerprint": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
        },
        "receipt": {
          "verified": true,
          "key_status": "current",
          "created_at": "2026-09-10T00:00:00.000Z"
        },
        "revocations": [],
        "unknown_lookups": 0
      },
      "expected": {
        "key_revocation": "not-revoked",
        "boundary": null,
        "revocation_ctx_id": null
      }
    },
